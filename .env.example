# Copie para .env e preencha (o arquivo .env nunca vai para o git):
#   cp .env.example .env

# Porta do site
PORT=3000

# Senha para abrir o site (recomendado). Login: qualquer usuário + esta senha.
SENHA=

# Opcional: token do bot (também dá para colar pela aba Alertas do site)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---- APIs oficiais das lojas (opcional, recomendado se aparecer "bloqueado") ----
# Com elas o preço vem da própria loja, sem ler o site. Passo a passo: docs/fontes-oficiais.md
# Mercado Livre: app grátis em https://developers.mercadolivre.com.br (traz TODOS os vendedores do produto)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Endereço de retorno do login da sua conta (o mesmo cadastrado no app). Padrão: https://localhost/setupsniper-ml
ML_REDIRECT_URI=
# Shopee: Shopee Affiliate (https://affiliate.shopee.com.br) → Open API
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# AliExpress: AliExpress Affiliate / Open Platform (https://openservice.aliexpress.com)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# ---- Redes de afiliados e Amazon (opcional; passo a passo em docs/fontes-oficiais.md) ----
# KaBuM! pela Awin: token em https://ui.awin.com/awin-api e o número da sua conta de publisher (aprovada no programa da KaBuM!)
AWIN_TOKEN=
AWIN_PUBLISHER_ID=
# Terabyte pela Lomadee: chave em Lomadee → menu do usuário → "Credenciais de API" (escopo products:read)
LOMADEE_API_KEY=
# Amazon pela Creators API: Associados (associados.amazon.com.br) → Ferramentas → Creators API → Create Application
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
# Sua tag de associado (ex.: seunome-20)
AMAZON_PARTNER_TAG=

# Intervalo de verificação dos produtos monitorados, em minutos
INTERVAL_MIN=15

# ---- Nuvem de arquivos (scripts/nuvem.sh) ----
# Sem NUVEM_SENHA a nuvem não liga (proteção contra deixá-la aberta).
NUVEM_USUARIO=eu
NUVEM_SENHA=
NUVEM_PORTA=8090
# Pasta compartilhada. No Termux, ~/storage/shared é o armazenamento interno do Android.
NUVEM_PASTA=~/storage/shared/Nuvem
